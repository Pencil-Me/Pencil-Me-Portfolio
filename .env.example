# Kopieren nach .env im Repo-Root (optional):
#   cp .env.example .env
#   docker compose --env-file .env up --build
#
# API-Keys muessen mit den App-spezifischen Env-Dateien uebereinstimmen
# (siehe README „Keys synchron halten“).

APP_ENV=development

# --- Datenbank (Compose-Service: pm-db) ---
DB_HOST=pm-db
DB_PORT=3306
DB_USERNAME=user
DB_PASSWORD=test
DB_DATABASE=portfolio_db

# --- API-Keys (Frontend fe_key / Admin be_key) ---
API_KEY_FE=secretApiFEkey
API_KEY_BE=secretApiBEkey

# --- SMTP (php-mailer-api, Python deprecated send_email) ---
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=mail@example.com
MAIL_PASSWORD=change-me
MAIL_SENDER=mail@example.com
MAIL_RECIPIENT=mail@example.com

# --- Python Flask API ---
BASE_URL=
LOG_LEVEL=DEBUG

# --- Vue Admin (Docker-Build-Args, Vite) ---
VITE_API_URL=http://localhost:8080/api
VITE_API_KEY=secretApiBEkey

# --- PHP REST (zusaetzlich: applications/php-rest-api/src/Inc/.env.dev) ---
# ALLOWED_ORIGINS, MAIL_ENDPOINT, HEALTH_ENDPOINT siehe php-rest-api/.env.example

# --- PHP Mailer (zusaetzlich: applications/php-mailer-api/src/Inc/.env.dev) ---
# ALLOWED_ORIGINS siehe php-mailer-api/src/Inc/.env.example
