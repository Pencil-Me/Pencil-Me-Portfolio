# Dependencies
node_modules/

# Build / test artifacts (monorepo-wide)
dist/
coverage/
.angular/
.fallow/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# JetBrains IDEs (PhpStorm, WebStorm, IntelliJ, …)
.idea/
*.iml
*.ipr
*.iws
out/

# Visual Studio Code
.vscode/*
!.vscode/extensions.json

# Cursor / workspace context (local IDE metadata)
.cursor/
.ws-context

# AI knowledge layers (Option C)
.ai-brain/
.agent/
docs/refactoring/

# ESLint
.eslintcache

# OS
.DS_Store
Thumbs.db

# Playwright
playwright-report/
test-results/
blob-report/

# Environment / secrets (keep *.example templates)
.env
.env.*
!.env.example
!**/.env.example

# Docker local overrides (keep *.example templates)
docker-compose.override.yml
docker-compose.prod.yml

# Security — local credentials (keep *.example templates)
secrets/*
!secrets/*.example

# Shared-hosting deploy (deploy/build-shared-hosting.ps1)
deploy/out/
deploy/out/*.zip
deploy/deploy.config.local.json
**/environment.deploy.ts

# PHP tooling caches (monorepo-wide)
.phpunit.result.cache
.phpunit.cache

# PHP runtime logs (app-specific paths may also gitignore locally)
**/src/logs/*.log
