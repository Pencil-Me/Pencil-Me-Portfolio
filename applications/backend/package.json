{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:unit:ci": "vitest run --coverage",
    "test:e2e": "start-server-and-test preview http://localhost:4173/backend/ \"cypress run --e2e\"",
    "test:e2e:ci": "npm run build && start-server-and-test preview http://localhost:4173/backend/ \"cypress run --e2e\"",
    "test:e2e:dev": "start-server-and-test \"vite dev --port 4173\" http://localhost:4173/backend/ \"cypress open --e2e\"",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "type-check:ci": "vue-tsc --build --force",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "lint:ci": "eslint src --ext .vue,.ts,.js --max-warnings 0",
    "lint:files": "eslint --fix --max-warnings 0",
    "format": "prettier --write src/",
    "format:files": "prettier --write",
    "fallow:analyze": "fallow dead-code && fallow dupes && fallow health --coverage coverage/coverage-final.json --min-score 90",
    "fallow": "fallow",
    "quality:ci": "npm run lint:ci && npm run type-check:ci && npm run test:unit:ci && npm run fallow:analyze"
  },
  "dependencies": {
    "axios": "^1.17.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.15",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.3.3",
    "@tsconfig/node20": "^20.1.2",
    "@types/jsdom": "^21.1.6",
    "@types/node": "^20.11.10",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitejs/plugin-vue": "^5.0.3",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.4",
    "@vue/tsconfig": "^0.5.1",
    "autoprefixer": "^10.4.17",
    "cypress": "^13.6.3",
    "eslint": "^8.49.0",
    "eslint-plugin-cypress": "^2.15.1",
    "eslint-plugin-vue": "^9.17.0",
    "fallow": "^2.89.0",
    "jsdom": "^24.0.0",
    "npm-run-all2": "^6.1.1",
    "postcss": "^8.5.6",
    "prettier": "^3.0.3",
    "start-server-and-test": "^2.0.3",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.3.0",
    "vite": "^5.0.11",
    "vitest": "^3.2.4",
    "vue-tsc": "^1.8.27"
  }
}
