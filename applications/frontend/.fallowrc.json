{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/main.ts",
    "karma.conf.js",
    "src/**/*.spec.ts",
    "src/testing/**/*.ts"
  ],
  "usedClassMembers": [
    {
      "implements": "PreloadingStrategy",
      "members": ["preload"]
    }
  ],
  "duplicates": {
    "minOccurrences": 3
  },
  "health": {
    "ignore": ["**/*.html", "**/*.spec.ts"]
  }
}
