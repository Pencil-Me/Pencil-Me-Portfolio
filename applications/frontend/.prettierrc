{
  "$schema": "https://json.schemastore.org/prettierrc",
  "plugins": ["@ianvs/prettier-plugin-sort-imports"],
  "singleQuote": true,
  "printWidth": 100,
  "tabWidth": 2,
  "trailingComma": "all",
  "semi": true,
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "auto",
  "importOrder": [
    "^@angular/(.*)$",
    "^rxjs",
    "<THIRD_PARTY_MODULES>",
    "",
    "^@gov/(.*)$",
    "^@core/(.*)$",
    "^@shared/(.*)$",
    "^@modules/(.*)$",
    "^@app/(.*)$",
    "",
    "^[./]"
  ],
  "importOrderParserPlugins": ["typescript", "decorators-legacy"],
  "importOrderTypeScriptVersion": "5.0.0"
}
