{
    "name": "pencil-me/php-mailer-api",
    "description": "SMTP mailer microservice for Pencil-Me Portfolio",
    "require": {
        "php": "^8.3",
        "phpmailer/phpmailer": "^6.9",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^1.12"
    },
    "autoload": {
        "psr-4": {
            "Controller\\Api\\": "src/Controller/Api/",
            "Inc\\": "src/Inc/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M"
    }
}
