# Use this as base for .env.dev and .env.prod
# Pfad: applications/php-mailer-api/src/Inc/

APP_ENV=development
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080
API_KEY_FE=secretApiFEkey
API_KEY_BE=secretApiBEkey

MAIL_HOST=smtp.host.de
MAIL_PORT=587
MAIL_USERNAME=mail_username
MAIL_PASSWORD=mail_password
MAIL_SENDER=mail_username
MAIL_FROM_NAME="Portfolio Contact"
MAIL_SMTP_SECURE=tls

BASE_URL=/

LOG_LEVEL=DEBUG
