# Kopieren nach .env.dev (lokal) bzw. .env.prod (Production)
# Pfad: applications/php-rest-api/src/Inc/

APP_ENV=development
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080
API_KEY_FE=secretApiFEkey
API_KEY_BE=secretApiBEkey

DB_HOST=pm-db
DB_PORT=3306
DB_DATABASE_NAME=portfolio_db
DB_USERNAME=user
DB_PASSWORD=test

BASE_URL=/

MAIL_RECIPIENT=email@domain.com
MAIL_ENDPOINT=http://pm-mailer_php/index.php/send_email
# Server-to-server key: must match API_KEY_BE in php-mailer-api (be_key on /send_email)
MAIL_API_KEY=secretApiBEkey

HEALTH_ENDPOINT=http://pm-mailer_php/index.php/healthcheck

# Monolog: DEBUG | INFO | WARNING | ERROR (Production-Default: INFO)
LOG_LEVEL=DEBUG
