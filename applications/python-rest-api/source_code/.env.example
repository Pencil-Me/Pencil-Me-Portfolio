# Kopieren nach source_code/.env (lokal) bzw. als Env-Vars in Docker/Production setzen

APP_ENV=development

DB_HOST=pm-db
DB_PORT=3306
DB_USERNAME=user
DB_PASSWORD=test
DB_DATABASE=portfolio_db

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=mail@example.com
MAIL_PASSWORD=change-me
MAIL_SENDER=mail@example.com
MAIL_RECIPIENT=mail@example.com

API_KEY_FE=secretApiFEkey
API_KEY_BE=secretApiBEkey

BASE_URL=

# Logging: DEBUG | INFO | WARNING | ERROR (Production-Default: INFO)
LOG_LEVEL=DEBUG
