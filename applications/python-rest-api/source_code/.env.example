# Kopieren nach source_code/.env (lokal) bzw. als Env-Vars in Docker/Production setzen

APP_ENV=development

DB_HOST=pm-db
DB_PORT=3306
DB_USERNAME=user
DB_PASSWORD=test
DB_DATABASE=portfolio_db

API_KEY_BE=secretApiBEkey

BASE_URL=

# CORS: kommagetrennte Origins (Admin-UI + Frontend ueber Gateway)
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Logging: DEBUG | INFO | WARNING | ERROR (Production-Default: INFO)
LOG_LEVEL=DEBUG
