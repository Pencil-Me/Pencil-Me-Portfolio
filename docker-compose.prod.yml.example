# Production-Override (Beispiel)
# Nutzung: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
# Oder kopieren nach docker-compose.prod.yml (gitignored)
#
# Prod: nur Nginx :8080 nach aussen; DB/PHP-APIs/Mailer nur Docker-intern.
# Admin-UI: Basic Auth via nginx.prod.conf + secrets/nginx.htpasswd

services:
  frontend:
    build:
      args:
        BUILD_CONFIGURATION: production

  backend:
    build:
      args:
        VITE_API_URL: https://api.pencil-me.eu/api
        VITE_API_KEY: ${API_KEY_BE}

  nginx:
    volumes:
      - ./nginx.prod.conf.example:/etc/nginx/conf.d/default.conf:ro
      - ./secrets/nginx.htpasswd:/etc/nginx/htpasswd/admin:ro

  python_api:
    environment:
      APP_ENV: production
      LOG_LEVEL: INFO
      ALLOWED_ORIGINS: ${ALLOWED_ORIGINS:-https://pencil-me.eu,https://www.pencil-me.eu}

  php_api:
    environment:
      APP_ENV: production
    ports: []

  php_mailer:
    environment:
      APP_ENV: production
    ports: []

  db:
    ports: []
