# Docker Shared-Hosting-Sim — mount als src/Inc/.env.dev im php_mailer-Container
# Mailer nur Server-zu-Server (REST -> Mailer), Host-Port 3002 fuer Logs/curl

APP_ENV=development
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
API_KEY_BE=secretApiBEkey

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=mail@example.com
MAIL_PASSWORD=change-me
MAIL_SENDER=mail@example.com
MAIL_RECIPIENT=email@domain.com

LOG_LEVEL=DEBUG
